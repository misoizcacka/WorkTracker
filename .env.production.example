# ─── PRODUCTION environment variables ────────────────────────────────────────
# DO NOT commit real values here. This file documents what needs to be set.
#
# Set these in:
#   Web:    Vercel dashboard → Settings → Environment Variables (Production only)
#   Mobile: eas secret:create --scope project --name KEY --value VALUE
#   Edge:   supabase secrets set KEY=VALUE --project-ref mjbldhhcogspurzjucfc
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — PROD project (mjbldhhcogspurzjucfc)
EXPO_PUBLIC_SUPABASE_URL="https://mjbldhhcogspurzjucfc.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<prod anon/public key>"

# Maps (restrict these keys by domain/SHA in Google Cloud + Geoapify consoles)
EXPO_PUBLIC_GEOAPIFY_KEY="<geoapify key>"
EXPO_PUBLIC_GOOGLE_MAPS_KEY="<google maps key>"

# App domain
EXPO_PUBLIC_APP_DOMAIN="koordinate.app"

# Store URLs
EXPO_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/id<YOUR_APP_ID>"
EXPO_PUBLIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=app.koord"

# ─── Supabase Edge Function secrets (set via supabase CLI) ───────────────────
# supabase secrets set --project-ref mjbldhhcogspurzjucfc \
#   STRIPE_SECRET_KEY=sk_live_... \
#   STRIPE_WEBHOOK_SECRET=whsec_live_... \
#   APP_URL=https://koordinate.app
